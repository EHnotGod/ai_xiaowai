# Relative SQLite paths are resolved against backend/; no MySQL needed for development.
DATABASE_URL=sqlite:///data/xiaowai.db
# MySQL alternative: create an empty database first and use a dedicated user.
# URL-encode special characters in the username/password.
# DATABASE_URL=mysql+pymysql://YOUR_USER:YOUR_PASSWORD@127.0.0.1:3306/xiaowai?charset=utf8mb4
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TOKEN_TTL_HOURS=24

# OpenAI-compatible provider. All three values are required for chat.
# Choose an available model in your own provider account; images need a vision model.
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60

# lexical: offline character n-gram demo; huggingface: optional semantic embeddings.
RAG_MODE=lexical
EMBEDDING_MODEL=moka-ai/m3e-small
KNOWLEDGE_DIR=knowledge
RAG_INDEX_PATH=data/knowledge-index.json
