# Original backend uses MySQL; create these tables with schema.sql.
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=web
CORS_ORIGINS=*

# Original Qwen multimodal answer model and Qwen tool-selection/city model.
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-vl-max
# Empty tool key/base URL reuse LLM_API_KEY / LLM_BASE_URL.
TOOL_API_KEY=
TOOL_BASE_URL=
TOOL_MODEL=qwen-max-latest

# Original Bocha search and Aliyun Marketplace ShowAPI weather services.
BOCHA_API_KEY=
BOCHA_SEARCH_URL=https://api.bochaai.com/v1/web-search
WEATHER_APPCODE=
WEATHER_HOST=https://ali-weather.showapi.com
WEATHER_PATH=/day15

# Absolute paths or paths relative to backend/. Provide your own authorized files.
EMBEDDING_MODEL_PATH=m3e-small
KNOWLEDGE_DIR=linces
INDEX_DIR=camp
AVATAR_PATH=nailong.png
